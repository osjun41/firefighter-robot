+"""Record one policy walking the video scenario (video_common.SCENARIO) with a changed torso mass, in Isaac Lab.
+
+The robot is followed by the same camera as the earlier scenario and push videos. Dynamics are as in the gap
+evaluation (actuation exact, observation noise as in training, no randomization or push); only the torso mass
+is changed. The fall termination is disabled so a fall stays on screen; the video ends FALL_TAIL_S after a fall.
+
+One run writes up to three files: <name>.mp4 (English captions), <name>_graph.mp4 (captions plus strip charts
+of commanded vs actual speed and yaw rate, with --graph) and <name>_nocaption.mp4 (no overlay).
+
+Usage (from the repository root):
+    uv run --project scripts/isaaclab scripts/isaaclab/s2r/record_gap_video.py --headless --policy logs/rsl_rl/s2r_dr000/<run>/model_11998.pt \
+        --title "..." --torso_mass_add 2.0 --stat "line 1|line 2" --out_dir videos/s2r --name x [--graph]
+"""
+
+"""Launch Isaac Sim Simulator first."""
+
+import argparse
+
+from isaaclab.app import AppLauncher
+
+# add argparse arguments
+parser = argparse.ArgumentParser(description="Record a policy on the video scenario with a changed torso mass.")
+parser.add_argument("--policy", type=str, required=True, help="RSL-RL checkpoint.")
+parser.add_argument("--title", type=str, required=True, help="Caption title (policy).")
+parser.add_argument("--torso_mass_add", type=float, default=0.0, help="Torso mass change (kg).")
+parser.add_argument("--stat", type=str, default="", help="Statistics box lines, separated by '|'.")
+parser.add_argument("--out_dir", type=str, default="videos/s2r", help="Output folder.")
+parser.add_argument("--name", type=str, required=True, help="Base file name.")
+parser.add_argument("--graph", action="store_true", default=False, help="Also write the version with strip charts.")
+parser.add_argument("--seed", type=int, default=0, help="Seed (observation noise).")
+parser.add_argument(
+    "--task", type=str, default="Velocity-Berkeley-Humanoid-Lite-Biped-S2R-DR000-v0", help="Task to run."
+)
+# append AppLauncher cli args
+AppLauncher.add_app_launcher_args(parser)
+args_cli = parser.parse_args()
+# rendering needs cameras
+args_cli.enable_cameras = True
+
+# launch omniverse app
+app_launcher = AppLauncher(args_cli)
+simulation_app = app_launcher.app
+
+"""Rest everything follows."""
+
+import gymnasium as gym
+import imageio
+import os
+import sys
+import torch
+
+from isaaclab.envs.mdp.commands.velocity_command import UniformVelocityCommand
+from isaaclab_tasks.utils import parse_env_cfg
+
+import berkeley_humanoid_lite.tasks  # noqa: F401
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from video_common import (  # noqa: E402
+    ARROW_HEIGHT,
+    CAM_EYE,
+    CAM_LOOKAT,
+    DURATION_S,
+    FALL_TILT_RAD,
+    TORSO_MASS_KG,
+    build_actor,
+    caption_overlay,
+    command_at,
+    graph_overlay,
+    measured_velocity,
+    set_torso_mass,
+)
+
+FALL_TAIL_S = 2.5
+
+
+def _debug_vis_above_head(self, event):
+    """Same as UniformVelocityCommand._debug_vis_callback, but drawn above the head instead of at 0.5 m."""
+    if not self.robot.is_initialized:
+        return
+    base_pos_w = self.robot.data.root_pos_w.clone()
+    base_pos_w[:, 2] += ARROW_HEIGHT
+    vel_des_arrow_scale, vel_des_arrow_quat = self._resolve_xy_velocity_to_arrow(self.command[:, :2])
+    vel_arrow_scale, vel_arrow_quat = self._resolve_xy_velocity_to_arrow(self.robot.data.root_lin_vel_b[:, :2])
+    self.goal_vel_visualizer.visualize(base_pos_w, vel_des_arrow_quat, vel_des_arrow_scale)
+    self.current_vel_visualizer.visualize(base_pos_w, vel_arrow_quat, vel_arrow_scale)
+
+
+UniformVelocityCommand._debug_vis_callback = _debug_vis_above_head
+
+
+def main():
+    env_cfg = parse_env_cfg(args_cli.task, device=args_cli.device, num_envs=1)
+    env_cfg.seed = args_cli.seed
+    env_cfg.episode_length_s = DURATION_S + 10.0
+    env_cfg.sim.render_interval = env_cfg.decimation
+    # as in the gap evaluation: dynamics set below, no randomization, push or reset perturbation
+    for term in ["physics_material", "add_base_mass", "scale_leg_mass", "shift_torso_com", "base_external_force_torque",
+                 "add_all_joint_default_pos", "scale_all_actuator_torque_constant"]:
+        if hasattr(env_cfg.events, term):
+            setattr(env_cfg.events, term, None)
+    env_cfg.events.reset_base.params["pose_range"] = {}
+    env_cfg.events.reset_base.params["velocity_range"] = {}
+    env_cfg.events.reset_robot_joints.params["position_range"] = (1.0, 1.0)
+    # keep a fall on screen
+    env_cfg.terminations.base_orientation = None
+    # commands are written every step; arrows as in the scenario videos
+    command_cfg = env_cfg.commands.base_velocity
+    command_cfg.heading_command = False
+    command_cfg.rel_standing_envs = 0.0
+    command_cfg.resampling_time_range = (1.0e6, 1.0e6)
+    command_cfg.debug_vis = True
+    command_cfg.goal_vel_visualizer_cfg.markers["arrow"].scale = (1.0, 0.1, 0.1)
+    command_cfg.current_vel_visualizer_cfg.markers["arrow"].scale = (1.0, 0.1, 0.1)
+    # follow camera
+    env_cfg.viewer.origin_type = "asset_root"
+    env_cfg.viewer.asset_name = "robot"
+    env_cfg.viewer.env_index = 0
+    env_cfg.viewer.eye = CAM_EYE
+    env_cfg.viewer.lookat = CAM_LOOKAT
+
+    env = gym.make(args_cli.task, cfg=env_cfg, render_mode="rgb_array")
+    unwrapped = env.unwrapped
+    device = unwrapped.device
+    robot = unwrapped.scene["robot"]
+    command_term = unwrapped.command_manager.get_term("base_velocity")
+    base_id = robot.find_bodies("base")[0][0]
+    set_torso_mass(robot, base_id, [args_cli.torso_mass_add])
+    actor = build_actor(torch.load(args_cli.policy, map_location="cpu", weights_only=False)["model_state_dict"], device)
+
+    add = args_cli.torso_mass_add
+    if abs(add) < 1e-9:
+        condition = f"Torso mass {TORSO_MASS_KG:.2f} kg, same as the training model (no dynamics gap)"
+    else:
+        condition = (f"Torso mass {TORSO_MASS_KG + add:.2f} kg vs {TORSO_MASS_KG:.2f} kg in training "
+                     f"({add:+.2f} kg, {'heavier' if add > 0 else 'lighter'} than the model)")
+    stat_lines = [s for s in args_cli.stat.split("|") if s]
+
+    os.makedirs(args_cli.out_dir, exist_ok=True)
+    fps = int(round(1.0 / unwrapped.step_dt))
+    paths = {"caption": os.path.join(args_cli.out_dir, f"{args_cli.name}.mp4"),
+             "nocaption": os.path.join(args_cli.out_dir, f"{args_cli.name}_nocaption.mp4")}
+    if args_cli.graph:
+        paths["graph"] = os.path.join(args_cli.out_dir, f"{args_cli.name}_graph.mp4")
+    writers = {k: imageio.get_writer(p, fps=fps, codec="libx264", quality=8, macro_block_size=1) for k, p in paths.items()}
+
+    history = {key: [] for key in ["t", "cmd_vx", "vx", "cmd_wz", "wz", "lin_err", "yaw_err"]}
+    dt = unwrapped.step_dt
+    fall_t = None
+    with torch.inference_mode():
+        obs = env.reset()[0]["policy"]
+        k = 0
+        while simulation_app.is_running():
+            t = k * dt
+            if t >= DURATION_S or (fall_t is not None and t >= fall_t + FALL_TAIL_S):
+                break
+            label, cmd = command_at(t)
+            command_term.vel_command_b[:] = torch.tensor(cmd, device=device)
+            obs[:, 0:3] = command_term.vel_command_b
+            obs = env.step(actor(obs))[0]["policy"]
+            k += 1
+            vx, vy, wz, tilt = (v.item() for v in measured_velocity(robot))
+            if fall_t is None and tilt > FALL_TILT_RAD:
+                fall_t = k * dt
+                print(f"[INFO] fell at t = {fall_t:.2f} s", flush=True)
+            history["t"].append(k * dt)
+            history["cmd_vx"].append(cmd[0])
+            history["vx"].append(vx)
+            history["cmd_wz"].append(cmd[2])
+            history["wz"].append(wz)
+            if fall_t is None:
+                history["lin_err"].append(((vx - cmd[0]) ** 2 + (vy - cmd[1]) ** 2) ** 0.5)
+                history["yaw_err"].append(abs(wz - cmd[2]))
+
+            frame = env.render()
+            writers["nocaption"].append_data(frame)
+            if fall_t is None:
+                status, color = ("Upright (no fall)" if k * dt < DURATION_S - 2 * dt
+                                 else "Finished the scenario without falling", (140, 230, 140))
+            else:
+                status, color = f"FELL at t = {fall_t:.1f} s (torso tilt over 45 deg)", (255, 120, 120)
+            captioned = caption_overlay(frame, args_cli.title, condition, k * dt, label, cmd, status, color, stat_lines)
+            writers["caption"].append_data(captioned)
+            if "graph" in writers:
+                writers["graph"].append_data(graph_overlay(captioned, history))
+    for w in writers.values():
+        w.close()
+    summary = f"fell at {fall_t:.1f} s" if fall_t is not None else "no fall"
+    print(f"[RESULT] {args_cli.name}: {summary}, mean speed error "
+          f"{sum(history['lin_err']) / max(1, len(history['lin_err'])):.3f} m/s, mean yaw error "
+          f"{sum(history['yaw_err']) / max(1, len(history['yaw_err'])):.3f} rad/s -> {list(paths.values())}", flush=True)
+    env.close()
+
+
+if __name__ == "__main__":
+    main()
+    simulation_app.close()
diff --git a/scripts/isaaclab/s2r/scenario_fall_rate.py b/scripts/isaaclab/s2r/scenario_fall_rate.py
new file mode 100644
index 0000000..bcb4b45
--- /dev/null
+++ b/scripts/isaaclab/s2r/scenario_fall_rate.py
@@ -0,0 +1,143 @@
+"""Fall rate of policies on the video scenario (video_common.SCENARIO) for several torso masses.
+
+Each (torso mass, repeat) is one environment; repeats differ only in the observation noise, as in training.
+Used to choose and caption the dynamics-gap videos: the recorded run is one sample, these numbers show how
+typical it is.
+
+Usage (from the repository root):
+    uv run --project scripts/isaaclab scripts/isaaclab/s2r/scenario_fall_rate.py --headless --torso_mass_add -2,0,1,2,3 --repeats 32 \
+        --policy DR000=logs/rsl_rl/s2r_dr000/<run>/model_11998.pt [--policy ...] [--out logs/s2r_study/x.csv]
+"""
+
+"""Launch Isaac Sim Simulator first."""
+
+import argparse
+
+from isaaclab.app import AppLauncher
+
+# add argparse arguments
+parser = argparse.ArgumentParser(description="Fall rate of policies on the video scenario.")
+parser.add_argument("--policy", action="append", required=True, metavar="NAME=CHECKPOINT", help="RSL-RL checkpoint.")
+parser.add_argument("--torso_mass_add", type=str, required=True, help="Comma-separated torso mass changes (kg).")
+parser.add_argument("--repeats", type=int, default=32, help="Runs per torso mass.")
+parser.add_argument("--seed", type=int, default=0, help="Seed.")
+parser.add_argument("--out", type=str, default=None, help="Optional CSV with one row per policy and mass.")
+parser.add_argument(
+    "--task", type=str, default="Velocity-Berkeley-Humanoid-Lite-Biped-S2R-DR000-v0", help="Task to run."
+)
+# append AppLauncher cli args
+AppLauncher.add_app_launcher_args(parser)
+args_cli = parser.parse_args()
+
+# launch omniverse app
+app_launcher = AppLauncher(args_cli)
+simulation_app = app_launcher.app
+
+"""Rest everything follows."""
+
+import csv
+import gymnasium as gym
+import os
+import sys
+import torch
+
+from isaaclab_tasks.utils import parse_env_cfg
+
+import berkeley_humanoid_lite.tasks  # noqa: F401
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from video_common import (  # noqa: E402
+    DURATION_S,
+    FALL_TILT_RAD,
+    build_actor,
+    command_at,
+    measured_velocity,
+    set_torso_mass,
+)
+
+
+def make_env(num_envs):
+    env_cfg = parse_env_cfg(args_cli.task, device=args_cli.device, num_envs=num_envs)
+    env_cfg.seed = args_cli.seed
+    env_cfg.episode_length_s = DURATION_S + 2.0
+    # dynamics are set below; no randomization or reset perturbation; observation noise as in training
+    for term in ["physics_material", "add_base_mass", "scale_leg_mass", "shift_torso_com", "base_external_force_torque",
+                 "add_all_joint_default_pos", "scale_all_actuator_torque_constant"]:
+        if hasattr(env_cfg.events, term):
+            setattr(env_cfg.events, term, None)
+    env_cfg.events.reset_base.params["pose_range"] = {}
+    env_cfg.events.reset_base.params["velocity_range"] = {}
+    env_cfg.events.reset_robot_joints.params["position_range"] = (1.0, 1.0)
+    command_cfg = env_cfg.commands.base_velocity
+    command_cfg.heading_command = False
+    command_cfg.rel_standing_envs = 0.0
+    command_cfg.resampling_time_range = (1.0e6, 1.0e6)
+    command_cfg.debug_vis = False
+    return gym.make(args_cli.task, cfg=env_cfg)
+
+
+def main():
+    masses = [float(m) for m in args_cli.torso_mass_add.split(",")]
+    n = len(masses) * args_cli.repeats
+    env = make_env(n)
+    unwrapped = env.unwrapped
+    device = unwrapped.device
+    robot = unwrapped.scene["robot"]
+    command_term = unwrapped.command_manager.get_term("base_velocity")
+    base_id = robot.find_bodies("base")[0][0]
+    mass_of_env = torch.tensor([m for m in masses for _ in range(args_cli.repeats)])
+    set_torso_mass(robot, base_id, mass_of_env)
+    dt = unwrapped.step_dt
+    steps = int(round(DURATION_S / dt))
+    rows = []
+
+    for spec in args_cli.policy:
+        name, path = spec.split("=", 1)
+        actor = build_actor(torch.load(path, map_location="cpu", weights_only=False)["model_state_dict"], device)
+        fell = torch.zeros(n, dtype=torch.bool, device=device)
+        fall_time = torch.full((n,), float("nan"), device=device)
+        lin_err = torch.zeros(n, device=device)
+        yaw_err = torch.zeros(n, device=device)
+        upright = torch.zeros(n, device=device)
+        with torch.inference_mode():
+            obs = env.reset()[0]["policy"]
+            for k in range(steps):
+                _, cmd = command_at(k * dt)
+                command = torch.tensor(cmd, device=device).expand(n, 3)
+                command_term.vel_command_b[:] = command
+                obs[:, 0:3] = command
+                obs, _, terminated, _, _ = env.step(actor(obs))
+                obs = obs["policy"]
+                vx, vy, wz, tilt = measured_velocity(robot)
+                fallen = (terminated | (tilt > FALL_TILT_RAD)) & ~fell
+                fall_time[fallen] = (k + 1) * dt
+                fell |= fallen
+                alive = (~fell).float()
+                lin_err += torch.sqrt((vx - cmd[0]) ** 2 + (vy - cmd[1]) ** 2) * alive
+                yaw_err += torch.abs(wz - cmd[2]) * alive
+                upright += alive
+        for m in masses:
+            sel = (mass_of_env == m).to(device)
+            falls = int(fell[sel].sum())
+            times = fall_time[sel & fell]
+            row = {"policy": name, "torso_mass_add": m, "runs": int(sel.sum()), "falls": falls,
+                   "fall_rate": falls / int(sel.sum()),
+                   "mean_fall_time_s": float(times.mean()) if len(times) else float("nan"),
+                   "lin_err": float((lin_err[sel] / upright[sel].clamp(min=1)).mean()),
+                   "yaw_err": float((yaw_err[sel] / upright[sel].clamp(min=1)).mean())}
+            rows.append(row)
+            print(f"[RESULT] {name:8s} torso {m:+5.2f} kg: falls {falls:2d}/{row['runs']} "
+                  f"(mean fall time {row['mean_fall_time_s']:.1f} s), lin err {row['lin_err']:.3f}, "
+                  f"yaw err {row['yaw_err']:.3f}", flush=True)
+    if args_cli.out:
+        os.makedirs(os.path.dirname(os.path.abspath(args_cli.out)), exist_ok=True)
+        with open(args_cli.out, "w", newline="") as f:
+            writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))
+            writer.writeheader()
+            writer.writerows(rows)
+    env.close()
+
+
+if __name__ == "__main__":
+    main()
+    simulation_app.close()
diff --git a/scripts/isaaclab/s2r/summarize_eval.py b/scripts/isaaclab/s2r/summarize_eval.py
new file mode 100644
index 0000000..a0ac92f
--- /dev/null
+++ b/scripts/isaaclab/s2r/summarize_eval.py
@@ -0,0 +1,53 @@
+"""Print the gap evaluation results as text tables (fall rate and tracking error per test condition).
+
+Usage (from the repository root):
+    python3 scripts/isaaclab/s2r/summarize_eval.py logs/s2r_study/eval DR000 DR100 ...
+"""
+
+import csv
+import os
+import sys
+from collections import defaultdict
+
+PARAMS = ["friction", "torso_mass_add", "leg_mass_scale", "torso_com_x", "torso_com_z"]
+NOMINAL = {"friction": 0.8, "torso_mass_add": 0.0, "leg_mass_scale": 1.0, "torso_com_x": 0.0, "torso_com_z": 0.0}
+
+
+def load(directory, name):
+    with open(os.path.join(directory, f"{name}.csv")) as f:
+        return list(csv.DictReader(f))
+
+
+def stats(rows):
+    n = len(rows)
+    mean = lambda key: sum(float(r[key]) for r in rows) / n
+    return (f"fall {100 * mean('fell'):5.1f}%  lin {mean('lin_err'):.3f}  ang {mean('ang_err'):.3f}  "
+            f"ret {mean('return'):6.2f}  P {mean('power_W'):5.1f}  da {mean('action_change'):.3f}  (n={n})")
+
+
+def main():
+    directory, names = sys.argv[1], sys.argv[2:]
+    for name in names:
+        rows = load(directory, name)
+        print(f"===== {name}")
+        nominal = [r for r in rows if r["group"].startswith("sweep")
+                   and all(abs(float(r[p]) - NOMINAL[p]) < 1e-6 for p in PARAMS)]
+        print(f"  nominal            {stats(nominal)}")
+        for p in PARAMS:
+            groups = defaultdict(list)
+            for r in rows:
+                if r["group"] == f"sweep:{p}":
+                    groups[float(r[p])].append(r)
+            for value in sorted(groups):
+                print(f"  {p:15s} {value:+7.3f} {stats(groups[value])}")
+        groups = defaultdict(list)
+        for r in rows:
+            if not r["group"].startswith("sweep"):
+                groups[r["group"]].append(r)
+        order = lambda g: (g.split(":")[0], float(g.split(":")[1]) if ":" in g else -1.0)
+        for group in sorted(groups, key=order):
+            print(f"  {group:23s} {stats(groups[group])}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/isaaclab/s2r/video_common.py b/scripts/isaaclab/s2r/video_common.py
new file mode 100644
index 0000000..fa2808f
--- /dev/null
+++ b/scripts/isaaclab/s2r/video_common.py
@@ -0,0 +1,187 @@
+"""Shared pieces of the dynamics-gap videos: the command scenario, torso mass changes and the English overlays.
+
+Import it after the simulation app has been launched (it is used by record_gap_video.py and scenario_fall_rate.py).
+"""
+
+import numpy as np
+import torch
+from PIL import Image, ImageDraw, ImageFont
+
+import isaaclab.utils.math as math_utils
+
+FONT_PATH = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
+FONT_BOLD_PATH = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
+
+# base tilt that counts as a fall (the training termination)
+FALL_TILT_RAD = 0.78
+# torso (base link) mass of the model
+TORSO_MASS_KG = 3.16
+# follow camera and velocity arrows, as in the earlier scenario and push videos (scripts/isaaclab/scenario)
+CAM_EYE = (2.0, 2.0, 1.15)
+CAM_LOOKAT = (0.0, 0.0, 0.55)
+ARROW_HEIGHT = 0.95
+
+# (caption, start time in s, (vx, vy, wz) command in the base frame); a segment lasts until the next one starts.
+# Moderate commands inside the training ranges (vx +-0.5, vy +-0.25 m/s, wz +-1 rad/s): a start from standing
+# straight to the maximum 0.5 m/s made even the fixed-dynamics policy fall in 4 of 32 runs on its own dynamics.
+SCENARIO = [
+    ("Stand still", 0.0, (0.0, 0.0, 0.0)),
+    ("Walk forward 0.4 m/s", 1.5, (0.4, 0.0, 0.0)),
+    ("Turn left in place 0.8 rad/s", 5.5, (0.0, 0.0, 0.8)),
+    ("Walk forward 0.3 m/s, turning right 0.5 rad/s", 8.5, (0.3, 0.0, -0.5)),
+    ("Side step left 0.2 m/s", 12.5, (0.0, 0.2, 0.0)),
+    ("Walk backward 0.3 m/s", 15.5, (-0.3, 0.0, 0.0)),
+    ("Stand still", 18.5, (0.0, 0.0, 0.0)),
+]
+DURATION_S = 20.5
+
+
+def command_at(t):
+    """Caption and (vx, vy, wz) command of the scenario at time t."""
+    label, cmd = SCENARIO[0][0], SCENARIO[0][2]
+    for name, start, c in SCENARIO:
+        if t + 1e-9 >= start:
+            label, cmd = name, c
+    return label, cmd
+
+
+def build_actor(state_dict, device):
+    """Deterministic actor MLP (Linear + ELU) from an RSL-RL checkpoint state dict."""
+    layers, index = [], 0
+    while f"actor.{index}.weight" in state_dict:
+        weight = state_dict[f"actor.{index}.weight"]
+        linear = torch.nn.Linear(weight.shape[1], weight.shape[0])
+        linear.weight.data.copy_(weight)
+        linear.bias.data.copy_(state_dict[f"actor.{index}.bias"])
+        layers.append(linear)
+        index += 2
+        if f"actor.{index}.weight" in state_dict:
+            layers.append(torch.nn.ELU())
+    return torch.nn.Sequential(*layers).to(device).eval()
+
+
+def set_torso_mass(robot, base_id, add_kg):
+    """Add add_kg (one value per environment) to the torso mass; its inertia scales with the mass (PhysX, CPU)."""
+    view = robot.root_physx_view
+    n = robot.num_instances
+    ids = torch.arange(n)
+    default_mass = robot.data.default_mass.cpu()
+    masses = default_mass.clone()
+    masses[:, base_id] += torch.as_tensor(add_kg, dtype=torch.float32).reshape(n)
+    view.set_masses(masses, ids)
+    view.set_inertias(robot.data.default_inertia.cpu() * (masses / default_mass)[:, :, None], ids)
+
+
+def measured_velocity(robot):
+    """(vx, vy) in the yaw frame and the world yaw rate, as in the tracking rewards; and the base tilt (rad)."""
+    lin = math_utils.quat_rotate_inverse(math_utils.yaw_quat(robot.data.root_quat_w), robot.data.root_lin_vel_w)
+    tilt = torch.acos(torch.clamp(-robot.data.projected_gravity_b[:, 2], -1.0, 1.0))
+    return lin[:, 0], lin[:, 1], robot.data.root_ang_vel_w[:, 2], tilt
+
+
+_fonts = {}
+
+
+def _font(size, bold=False):
+    key = (size, bold)
+    if key not in _fonts:
+        _fonts[key] = ImageFont.truetype(FONT_BOLD_PATH if bold else FONT_PATH, size)
+    return _fonts[key]
+
+
+def _panel(draw, box, alpha=150):
+    draw.rounded_rectangle(box, radius=12, fill=(0, 0, 0, alpha))
+
+
+def caption_overlay(frame, title, condition, t, label, cmd, status, status_color, stat_lines):
+    """English captions: title and condition, current command, status (walking / fell), arrow legend, statistics."""
+    img = Image.fromarray(frame).convert("RGBA")
+    layer = Image.new("RGBA", img.size, (0, 0, 0, 0))
+    draw = ImageDraw.Draw(layer)
+    W, H = img.size
+    vx, vy, wz = cmd
+    lines = [
+        (title, _font(26, True), (255, 255, 255)),
+        (condition, _font(22), (255, 220, 120)),
+        (f"Command: {label}", _font(22), (235, 235, 235)),
+        (f"vx {vx:+.2f} m/s   vy {vy:+.2f} m/s   wz {wz:+.2f} rad/s        t = {t:4.1f} s", _font(19),
+         (215, 215, 215)),
+        (status, _font(22, True), status_color),
+    ]
+    h = 16 + sum(f.size + 9 for _, f, _ in lines)
+    _panel(draw, (16, 14, W - 16, 14 + h))
+    y = 22
+    for text, f, color in lines:
+        draw.text((32, y), text, font=f, fill=color)
+        y += f.size + 9
+
+    # bottom left: arrow legend
+    legend = [((40, 220, 40), "Green arrow: commanded velocity"), ((60, 90, 255), "Blue arrow: actual velocity")]
+    f = _font(19)
+    line_h = f.size + 9
+    top = H - 16 - line_h * len(legend) - 18
+    _panel(draw, (16, top, 400, H - 16))
+    y = top + 10
+    for color, text in legend:
+        draw.rectangle((32, y + 4, 54, y + 18), fill=color + (255,))
+        draw.text((64, y), text, font=f, fill=(240, 240, 240))
+        y += line_h
+
+    # bottom right: statistics of this condition
+    if stat_lines:
+        widths = [draw.textlength(s, font=f) for s in stat_lines]
+        box_w = max(widths) + 36
+        top = H - 16 - line_h * len(stat_lines) - 18
+        _panel(draw, (W - 16 - box_w, top, W - 16, H - 16))
+        y = top + 10
+        for s in stat_lines:
+            draw.text((W - 16 - box_w + 18, y), s, font=f, fill=(240, 240, 240))
+            y += line_h
+    return np.array(Image.alpha_composite(img, layer).convert("RGB"))
+
+
+def graph_overlay(frame, history, window_s=6.0):
+    """Strip charts of the commanded vs actual forward speed and yaw rate over the last window_s, plus the mean
+    tracking errors so far (while upright). history: dict of lists t, cmd_vx, vx, cmd_wz, wz, lin_err, yaw_err."""
+    img = Image.fromarray(frame).convert("RGBA")
+    layer = Image.new("RGBA", img.size, (0, 0, 0, 0))
+    draw = ImageDraw.Draw(layer)
+    W, H = img.size
+    pw, ph = 440, 100  # plot size (the panel must end above the statistics box at the bottom right)
+    x0 = W - 16 - pw - 36
+    top = 198
+    box = (x0, top, W - 16, top + 2 * (ph + 46) + 92)
+    _panel(draw, box, alpha=165)
+    t = np.array(history["t"])
+    t_end = t[-1] if len(t) else 0.0
+    t_start = max(0.0, t_end - window_s)
+    sel = t >= t_start
+    small = _font(17)
+    plots = [("Forward speed vx (m/s)", "cmd_vx", "vx", (-0.7, 0.7)), ("Yaw rate wz (rad/s)", "cmd_wz", "wz", (-1.4, 1.4))]
+    for i, (name, key_cmd, key_act, (lo, hi)) in enumerate(plots):
+        px, py = x0 + 22, top + 14 + i * (ph + 46)
+        draw.text((px, py), name, font=small, fill=(235, 235, 235))
+        gy = py + 26
+        draw.rectangle((px, gy, px + pw, gy + ph), outline=(120, 120, 120, 255))
+        zero = gy + ph * (hi - 0.0) / (hi - lo)
+        draw.line((px, zero, px + pw, zero), fill=(90, 90, 90, 255))
+
+        def to_xy(tt, v):
+            return (px + pw * (tt - t_start) / window_s, gy + ph * (hi - np.clip(v, lo, hi)) / (hi - lo))
+
+        for key, color, width in [(key_cmd, (40, 220, 40, 255), 3), (key_act, (90, 150, 255, 255), 2)]:
+            values = np.array(history[key])[sel]
+            if len(values) > 1:
+                pts = [to_xy(tt, v) for tt, v in zip(t[sel], values)]
+                draw.line(pts, fill=color, width=width, joint="curve")
+    # legend and running errors
+    ly = top + 2 * (ph + 46) + 10
+    draw.rectangle((x0 + 22, ly + 5, x0 + 44, ly + 9), fill=(40, 220, 40, 255))
+    draw.text((x0 + 52, ly - 3), "command", font=small, fill=(235, 235, 235))
+    draw.rectangle((x0 + 150, ly + 5, x0 + 172, ly + 9), fill=(90, 150, 255, 255))
+    draw.text((x0 + 180, ly - 3), "actual", font=small, fill=(235, 235, 235))
+    lin = np.mean(history["lin_err"]) if history["lin_err"] else 0.0
+    yaw = np.mean(history["yaw_err"]) if history["yaw_err"] else 0.0
+    draw.text((x0 + 22, ly + 22), "Mean tracking error so far:", font=small, fill=(255, 220, 120))
+    draw.text((x0 + 22, ly + 44), f"speed {lin:.3f} m/s, yaw rate {yaw:.3f} rad/s", font=small, fill=(255, 220, 120))
+    return np.array(Image.alpha_composite(img, layer).convert("RGB"))
diff --git a/scripts/isaaclab/scenario/record_isaaclab.py b/scripts/isaaclab/scenario/record_isaaclab.py
new file mode 100644
index 0000000..27ec42b
--- /dev/null
+++ b/scripts/isaaclab/scenario/record_isaaclab.py
@@ -0,0 +1,170 @@
+"""Record the scripted scenario in Isaac Lab, following one robot, with an exported ONNX policy.
+
+The scenario (forward, 90 deg right turn, forward, left, backward) is defined in scenario_common.py.
+The robot runs in nominal conditions (no randomization, observation noise or reset perturbation)
+so the video can be compared with record_mujoco.py.
+
+Usage (from the repository root):
+    uv run --project scripts/isaaclab scripts/isaaclab/scenario/record_isaaclab.py --config configs/policy_latest.yaml \
+        --out videos/scenario/isaaclab_x.mp4 --headless [--label NAME] [--no_caption]
+"""
+
+"""Launch Isaac Sim Simulator first."""
+
+import argparse
+import os
+import sys
+
+from isaaclab.app import AppLauncher
+
+# add argparse arguments
+parser = argparse.ArgumentParser(description="Record the scenario video in Isaac Lab.")
+parser.add_argument("--config", type=str, required=True, help="Path to the deployment config of the policy.")
+parser.add_argument("--out", type=str, required=True, help="Output video path (.mp4).")
+parser.add_argument("--label", type=str, default=None, help="Policy name in the caption (default: config name).")
+parser.add_argument("--no_caption", action="store_true", default=False, help="Do not draw the text captions.")
+parser.add_argument(
+    "--task", type=str, default="Velocity-Berkeley-Humanoid-Lite-Biped-v0", help="Name of the task."
+)
+# append AppLauncher cli args
+AppLauncher.add_app_launcher_args(parser)
+args_cli = parser.parse_args()
+# rendering needs cameras
+args_cli.enable_cameras = True
+
+# launch omniverse app
+app_launcher = AppLauncher(args_cli)
+simulation_app = app_launcher.app
+
+"""Rest everything follows."""
+
+import gymnasium as gym
+import imageio
+import numpy as np
+import torch
+
+import onnxruntime as ort
+from omegaconf import OmegaConf
+
+from isaaclab.envs.mdp.commands.velocity_command import UniformVelocityCommand
+from isaaclab_tasks.utils import parse_env_cfg
+
+# Import extensions to set up environment tasks
+import berkeley_humanoid_lite.tasks  # noqa: F401
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from scenario_common import (  # noqa: E402
+    ARROW_HEIGHT,
+    CAM_EYE,
+    CAM_LOOKAT,
+    ScenarioRunner,
+    overlay,
+    yaw_from_quat_wxyz,
+)
+
+
+def _debug_vis_above_head(self, event):
+    """Same as UniformVelocityCommand._debug_vis_callback, but drawn above the head instead of at 0.5 m."""
+    if not self.robot.is_initialized:
+        return
+    base_pos_w = self.robot.data.root_pos_w.clone()
+    base_pos_w[:, 2] += ARROW_HEIGHT
+    vel_des_arrow_scale, vel_des_arrow_quat = self._resolve_xy_velocity_to_arrow(self.command[:, :2])
+    vel_arrow_scale, vel_arrow_quat = self._resolve_xy_velocity_to_arrow(self.robot.data.root_lin_vel_b[:, :2])
+    self.goal_vel_visualizer.visualize(base_pos_w, vel_des_arrow_quat, vel_des_arrow_scale)
+    self.current_vel_visualizer.visualize(base_pos_w, vel_arrow_quat, vel_arrow_scale)
+
+
+UniformVelocityCommand._debug_vis_callback = _debug_vis_above_head
+
+
+def main():
+    """Record the scenario in Isaac Lab."""
+    deploy_cfg = OmegaConf.load(args_cli.config)
+    label = args_cli.label or os.path.splitext(os.path.basename(args_cli.config))[0]
+
+    env_cfg = parse_env_cfg(args_cli.task, device=args_cli.device, num_envs=1)
+    # run the policy at the rate it was trained for
+    env_cfg.decimation = round(deploy_cfg.policy_dt / env_cfg.sim.dt)
+    env_cfg.sim.render_interval = env_cfg.decimation
+    env_cfg.episode_length_s = 120.0
+
+    # the command is written directly every step
+    command_cfg = env_cfg.commands.base_velocity
+    command_cfg.heading_command = False
+    command_cfg.rel_standing_envs = 0.0
+    command_cfg.resampling_time_range = (1.0e6, 1.0e6)
+    # arrows sized to read like the MuJoCo ones (~0.45 m at 0.3 m/s); the default 0.5 x 0.5 x 0.5 hides the torso
+    command_cfg.goal_vel_visualizer_cfg.markers["arrow"].scale = (1.0, 0.1, 0.1)
+    command_cfg.current_vel_visualizer_cfg.markers["arrow"].scale = (1.0, 0.1, 0.1)
+
+    # nominal conditions: no randomization, no observation noise, no reset perturbation
+    events = env_cfg.events
+    events.physics_material = None
+    events.add_base_mass = None
+    events.add_all_joint_default_pos = None
+    events.scale_all_actuator_torque_constant = None
+    events.base_external_force_torque = None
+    events.reset_base.params["pose_range"] = {}
+    events.reset_base.params["velocity_range"] = {}
+    events.reset_robot_joints.params["position_range"] = (1.0, 1.0)
+    env_cfg.observations.policy.enable_corruption = False
+
+    # follow the robot, same view as record_mujoco.py
+    env_cfg.viewer.origin_type = "asset_root"
+    env_cfg.viewer.asset_name = "robot"
+    env_cfg.viewer.env_index = 0
+    env_cfg.viewer.eye = CAM_EYE
+    env_cfg.viewer.lookat = CAM_LOOKAT
+
+    # create isaac environment
+    env = gym.make(args_cli.task, cfg=env_cfg, render_mode="rgb_array")
+    unwrapped = env.unwrapped
+    robot = unwrapped.scene["robot"]
+    command_term = unwrapped.command_manager.get_term("base_velocity")
+
+    session = ort.InferenceSession(deploy_cfg.policy_checkpoint_path, providers=["CPUExecutionProvider"])
+    input_name = session.get_inputs()[0].name
+    print(f"[INFO]: Loading ONNX policy from: {deploy_cfg.policy_checkpoint_path}")
+
+    title = f"Isaac Lab (학습 환경)  |  정책: {label}"
+    runner = ScenarioRunner(unwrapped.step_dt)
+    os.makedirs(os.path.dirname(os.path.abspath(args_cli.out)), exist_ok=True)
+    writer = imageio.get_writer(
+        args_cli.out, fps=int(round(1.0 / unwrapped.step_dt)), codec="libx264", quality=8, macro_block_size=1
+    )
+
+    obs, _ = env.reset()
+    obs = obs["policy"]
+    falls = 0
+    while simulation_app.is_running():
+        yaw = yaw_from_quat_wxyz(robot.data.root_quat_w[0].cpu().numpy())
+        label_now, cmd, turn_info = runner.command(yaw)
+        if runner.done:
+            break
+        with torch.inference_mode():
+            command_term.vel_command_b[:] = torch.tensor(cmd, device=unwrapped.device)
+            # the observation still holds the previous command; refresh it so the policy sees the new one
+            obs[:, 0:3] = command_term.vel_command_b
+            actions = session.run(None, {input_name: obs.cpu().numpy().astype(np.float32)})[0]
+            obs, _, terminated, _, _ = env.step(torch.from_numpy(actions).to(unwrapped.device))
+            obs = obs["policy"]
+        if bool(terminated[0]):
+            falls += 1
+            print(f"[INFO] Robot fell at t={runner.t:.1f}s")
+        frame = env.render()
+        if not args_cli.no_caption:
+            frame = overlay(frame, title, runner.t, label_now, cmd, turn_info, runner.note())
+        writer.append_data(frame)
+    writer.close()
+    print(f"[INFO] Turn result (deg, s, reached): {runner.turn_result}, falls: {falls}, video: {args_cli.out}")
+
+    # close the simulator
+    env.close()
+
+
+if __name__ == "__main__":
+    # run the main function
+    main()
+    # close sim app
+    simulation_app.close()
diff --git a/scripts/isaaclab/scenario/record_mujoco.py b/scripts/isaaclab/scenario/record_mujoco.py
new file mode 100644
index 0000000..436cf4d
--- /dev/null
+++ b/scripts/isaaclab/scenario/record_mujoco.py
@@ -0,0 +1,138 @@
+"""Record the scripted scenario in MuJoCo (sim2sim), following one robot, with a deployment config.
+
+The scenario (forward, 90 deg right turn, forward, left, backward) is defined in scenario_common.py.
+It uses the same MujocoSimulator and RlController as play_mujoco.py, with the gamepad replaced by the
+scenario and the viewer replaced by an offscreen renderer. Velocity arrows are drawn like the Isaac Lab ones.
+
+Usage (from the repository root):
+    uv run --project scripts/isaaclab scripts/isaaclab/scenario/record_mujoco.py --config configs/policy_latest.yaml \
+        --out videos/scenario/mujoco_x.mp4 [--label NAME] [--no_caption] [--no_obs_noise]
+"""
+
+import argparse
+import importlib
+import os
+import types
+
+import imageio
+import numpy as np
+import torch
+import mujoco
+import mujoco.viewer
+from omegaconf import OmegaConf
+
+from scenario_common import ARROW_HEIGHT, CAM_EYE, CAM_LOOKAT, ScenarioRunner, overlay, yaw_from_quat_wxyz
+
+parser = argparse.ArgumentParser(description="Record the scenario video in MuJoCo.")
+parser.add_argument("--config", type=str, required=True, help="Path to the deployment config of the policy.")
+parser.add_argument("--out", type=str, required=True, help="Output video path (.mp4).")
+parser.add_argument("--label", type=str, default=None, help="Policy name in the caption (default: config name).")
+parser.add_argument("--no_caption", action="store_true", help="Do not draw the text captions.")
+parser.add_argument("--no_obs_noise", action="store_true", help="Feed noise-free observations to the policy.")
+parser.add_argument("--seed", type=int, default=0, help="Seed of the observation noise.")
+args = parser.parse_args()
+
+
+class ScriptedCommands:
+    """Stands in for Se2Gamepad; the scenario writes the commands."""
+
+    def __init__(self, *args, **kwargs):
+        self.commands = {"velocity_x": 0.0, "velocity_y": 0.0, "velocity_yaw": 0.0, "mode_switch": 0}
+
+    def run(self):
+        pass
+
+
+# run headless and as fast as possible: no viewer window, no gamepad, no real-time sleep
+mujoco.viewer.launch_passive = lambda model, data: types.SimpleNamespace(sync=lambda: None)
+mujoco_env = importlib.import_module("berkeley_humanoid_lite.environments.mujoco")
+mujoco_env.Se2Gamepad = ScriptedCommands
+mujoco_env.time.sleep = lambda seconds: None
+
+from berkeley_humanoid_lite.environments import MujocoSimulator  # noqa: E402
+from berkeley_humanoid_lite_lowlevel.policy.rl_controller import RlController  # noqa: E402
+
+WIDTH, HEIGHT = 1280, 720
+
+
+def add_arrow(scene, start, vec, rgba, width=0.02):
+    """Add an arrow from start along vec to the scene."""
+    if scene.ngeom >= scene.maxgeom or np.linalg.norm(vec) < 1e-3:
+        return
+    geom = scene.geoms[scene.ngeom]
+    mujoco.mjv_initGeom(
+        geom, mujoco.mjtGeom.mjGEOM_ARROW, np.zeros(3), np.zeros(3), np.zeros(9), np.array(rgba, dtype=np.float32)
+    )
+    mujoco.mjv_connector(geom, mujoco.mjtGeom.mjGEOM_ARROW, width, start, start + vec)
+    scene.ngeom += 1
+
+
+def arrow_vec(base_rot, vel_xy_base):
+    """Base-frame xy velocity as a world-frame arrow, 1.5 m long per m/s like the Isaac Lab markers."""
+    return base_rot @ np.array([vel_xy_base[0], vel_xy_base[1], 0.0]) * 1.5
+
+
+def main():
+    cfg = OmegaConf.load(args.config)
+    label = args.label or os.path.splitext(os.path.basename(args.config))[0]
+    obs_noise = not args.no_obs_noise
+    # same seed, same motion: the captioned and caption-free videos match
+    torch.manual_seed(args.seed)
+
+    robot = MujocoSimulator(cfg, obs_noise=obs_noise)
+    obs = robot.reset()
+    controller = RlController(cfg)
+    controller.load_policy()
+    model, data = robot.mj_model, robot.mj_data
+
+    model.vis.global_.offwidth, model.vis.global_.offheight = WIDTH, HEIGHT
+    renderer = mujoco.Renderer(model, height=HEIGHT, width=WIDTH)
+    base_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, "base")
+    # same view as record_isaaclab.py: eye and lookat offsets from the root position
+    camera = mujoco.MjvCamera()
+    camera.type = mujoco.mjtCamera.mjCAMERA_FREE
+    view = np.array(CAM_LOOKAT) - np.array(CAM_EYE)
+    camera.distance = float(np.linalg.norm(view))
+    camera.azimuth = float(np.degrees(np.arctan2(view[1], view[0])))
+    camera.elevation = float(np.degrees(np.arcsin(view[2] / camera.distance)))
+
+    title = f"MuJoCo (sim2sim)  |  정책: {label}  |  관측 노이즈 {'있음' if obs_noise else '없음'}"
+    runner = ScenarioRunner(cfg.policy_dt)
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    writer = imageio.get_writer(
+        args.out, fps=int(round(1.0 / cfg.policy_dt)), codec="libx264", quality=8, macro_block_size=1
+    )
+
+    fell = False
+    while True:
+        label_now, cmd, turn_info = runner.command(yaw_from_quat_wxyz(data.qpos[3:7]))
+        if runner.done:
+            break
+        vx, vy, wz = cmd
+        # MujocoSimulator halves velocity_y (gamepad scaling) before it reaches the policy, so pre-scale it
+        robot.command_controller.commands.update(velocity_x=vx, velocity_y=vy / 0.5, velocity_yaw=wz)
+        obs = robot.step(torch.tensor(controller.update(obs.numpy())))
+
+        base_rot = data.xmat[base_id].reshape(3, 3)
+        vel_base = base_rot.T @ data.qvel[0:3]
+        arrow_start = data.xpos[base_id] + np.array([0.0, 0.0, ARROW_HEIGHT])
+        camera.lookat[:] = data.xpos[base_id] + np.array(CAM_LOOKAT)
+        renderer.update_scene(data, camera=camera)
+        add_arrow(renderer.scene, arrow_start, arrow_vec(base_rot, (vx, vy)), (0.0, 1.0, 0.0, 1.0))
+        add_arrow(renderer.scene, arrow_start, arrow_vec(base_rot, vel_base[:2]), (0.0, 0.0, 1.0, 1.0))
+        frame = renderer.render().copy()
+        if not args.no_caption:
+            frame = overlay(frame, title, runner.t, label_now, cmd, turn_info, runner.note())
+        writer.append_data(frame)
+
+        tilt = np.degrees(np.arccos(np.clip(base_rot[2, 2], -1.0, 1.0)))
+        if tilt > 60.0:
+            fell = True
+            print(f"[INFO] Robot fell at t={runner.t:.1f}s")
+            break
+    writer.close()
+    print(f"[INFO] Turn result (deg, s, reached): {runner.turn_result}, fell: {fell}, video: {args.out}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/isaaclab/scenario/scenario_common.py b/scripts/isaaclab/scenario/scenario_common.py
new file mode 100644
index 0000000..d56d3d4
--- /dev/null
+++ b/scripts/isaaclab/scenario/scenario_common.py
@@ -0,0 +1,165 @@
+"""Shared scenario, camera and caption overlay for the Isaac Lab and MuJoCo scenario videos."""
+
+import os
+
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+
+# Korean captions need a CJK font (Ubuntu: sudo apt install fonts-noto-cjk)
+FONT_PATH = "/usr/share/fonts/opentype/noto/NotoSansCJK-Medium.ttc"
+
+TURN_TARGET_DEG = -90.0  # right turn
+TURN_RATE = -1.0  # rad/s, the max yaw rate in the training command range
+TURN_TIMEOUT_S = 8.0  # a 90 deg turn at 1 rad/s takes ~1.6 s; move on if the policy cannot turn
+
+# velocity arrows are drawn this high above the root (the root is at foot level, top of torso ~0.8 m)
+ARROW_HEIGHT = 0.95
+# follow camera, as offsets from the root position in world axes
+CAM_EYE = (2.0, 2.0, 1.15)
+CAM_LOOKAT = (0.0, 0.0, 0.55)
+
+# (label, duration in s or None for the turn, (vx, vy, wz) command in the base frame)
+SCENARIO = [
+    ("준비 (정지)", 1.0, (0.0, 0.0, 0.0)),
+    ("전진", 3.0, (0.3, 0.0, 0.0)),
+    ("오른쪽 90° 회전", None, (0.0, 0.0, TURN_RATE)),
+    ("전진", 2.0, (0.3, 0.0, 0.0)),
+    ("왼쪽으로 이동", 2.0, (0.0, 0.2, 0.0)),
+    ("후진", 3.0, (-0.3, 0.0, 0.0)),
+]
+
+
+def _font(size):
+    if not os.path.isfile(FONT_PATH):
+        raise FileNotFoundError(f"{FONT_PATH} not found. Install it with: sudo apt install fonts-noto-cjk")
+    # pick the Korean face inside the CJK collection
+    for idx in range(10):
+        try:
+            font = ImageFont.truetype(FONT_PATH, size, index=idx)
+        except OSError:
+            break
+        if "KR" in " ".join(font.getname()):
+            return font
+    return ImageFont.truetype(FONT_PATH, size)
+
+
+_fonts = {}
+
+
+def _get_fonts():
+    if not _fonts:
+        _fonts.update(title=_font(26), main=_font(30), small=_font(22))
+    return _fonts["title"], _fonts["main"], _fonts["small"]
+
+
+def wrap_deg(a):
+    return (a + 180.0) % 360.0 - 180.0
+
+
+def yaw_from_quat_wxyz(q):
+    w, x, y, z = q
+    return np.degrees(np.arctan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z)))
+
+
+def overlay(frame, title, t, label, cmd, turn_info=None, note=None):
+    """Draw the captions on an RGB frame (H, W, 3 uint8) and return the new frame."""
+    font_title, font_main, font_small = _get_fonts()
+    img = Image.fromarray(frame).convert("RGBA")
+    layer = Image.new("RGBA", img.size, (0, 0, 0, 0))
+    draw = ImageDraw.Draw(layer)
+    W, H = img.size
+
+    # top: title and current command
+    vx, vy, wz = cmd
+    lines = [
+        (title, font_title, (220, 220, 220)),
+        (f"현재 명령: {label}", font_main, (255, 255, 255)),
+        (f"vx = {vx:+.2f} m/s   vy = {vy:+.2f} m/s   wz = {wz:+.2f} rad/s      t = {t:4.1f} s", font_small,
+         (230, 230, 230)),
+    ]
+    if turn_info is not None:
+        lines.append((turn_info, font_small, (255, 220, 120)))
+    if note is not None:
+        lines.append((note, font_small, (255, 140, 140)))
+    h = 18 + sum(f.size + 10 for _, f, _ in lines)
+    draw.rounded_rectangle((16, 14, W - 16, 14 + h), radius=12, fill=(0, 0, 0, 150))
+    y = 24
+    for text, f, color in lines:
+        draw.text((32, y), text, font=f, fill=color)
+        y += f.size + 10
+
+    # bottom left: arrow legend
+    legend = [
+        ((40, 220, 40), "초록 화살표: 명령 속도 (평면 이동 방향·크기)"),
+        ((60, 90, 255), "파란 화살표: 실제 속도 (로봇 몸통 기준)"),
+        (None, "※ 회전 속도(wz)는 화살표에 나타나지 않습니다"),
+    ]
+    line_h = font_small.size + 10
+    top = H - 20 - line_h * len(legend) - 16
+    draw.rounded_rectangle((16, top, 600, H - 16), radius=12, fill=(0, 0, 0, 150))
+    y = top + 12
+    for color, text in legend:
+        x = 32
+        if color is not None:
+            draw.rectangle((x, y + 5, x + 22, y + 5 + 14), fill=color + (255,))
+            x += 34
+        draw.text((x, y), text, font=font_small, fill=(240, 240, 240))
+        y += line_h
+
+    return np.array(Image.alpha_composite(img, layer).convert("RGB"))
+
+
+class ScenarioRunner:
+    """Steps through SCENARIO. Call command(yaw_deg) once per policy step until done is True."""
+
+    def __init__(self, policy_dt):
+        self.dt = policy_dt
+        self.phase = 0
+        self.t_phase = 0.0
+        self.t = 0.0
+        self.turn_accum = 0.0
+        self.prev_yaw = None
+        self.turn_result = None
+        self.done = False
+
+    def command(self, yaw_deg):
+        """Return (label, cmd, turn_info) for this step and advance time."""
+        label, duration, cmd = SCENARIO[self.phase]
+        turn_info = None
+        if duration is None:
+            # turn until the measured heading has changed by TURN_TARGET_DEG, or the time limit
+            if self.prev_yaw is None:
+                self.prev_yaw = yaw_deg
+            self.turn_accum += wrap_deg(yaw_deg - self.prev_yaw)
+            self.prev_yaw = yaw_deg
+            turn_info = (f"회전량 {abs(self.turn_accum):4.0f}° / {abs(TURN_TARGET_DEG):.0f}°   "
+                         f"(시간 제한 {TURN_TIMEOUT_S:.0f} s 중 {self.t_phase:3.1f} s)")
+            reached = self.turn_accum <= TURN_TARGET_DEG
+            if reached or self.t_phase >= TURN_TIMEOUT_S:
+                self.turn_result = (self.turn_accum, self.t_phase, reached)
+                self._next()
+                return self.command(yaw_deg)
+        elif self.t_phase >= duration - 1e-9:
+            self._next()
+            if self.done:
+                return label, cmd, None
+            return self.command(yaw_deg)
+        self.t_phase += self.dt
+        self.t += self.dt
+        return label, cmd, turn_info
+
+    def _next(self):
+        self.phase += 1
+        self.t_phase = 0.0
+        if self.phase >= len(SCENARIO):
+            self.done = True
+            self.phase = len(SCENARIO) - 1
+
+    def note(self):
+        """Caption line with the result of the turn, once it is over."""
+        if self.turn_result is None:
+            return None
+        accum, t, reached = self.turn_result
+        if reached:
+            return f"회전 완료: {abs(accum):.0f}° ({t:.1f} s)"
+        return f"회전 시간 제한 도달: {abs(accum):.0f}°만 회전 ({t:.1f} s) → 다음 동작으로 넘어감"
